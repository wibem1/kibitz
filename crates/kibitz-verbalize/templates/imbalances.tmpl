# imbalances.tmpl — one headline sentence per (kind, magnitude), with
# optional phase-specific overrides keyed `imbalance.<Kind>.<magnitude>.<phase>`.
# Slots: {beneficiary} ("White"/"Black"), {aspect} (from the aspect.* keys).
# Evidence is rendered as separate follow-on sentences (evidence.tmpl) that
# the code appends after the headline.

# Human names for each imbalance aspect (used by balanced/generic templates).
aspect.MinorPieces = die Leichtfiguren
aspect.PawnStructure = die Bauernstruktur
aspect.Material = das Material
aspect.FilesDiagonals = die Linien und Diagonalen
aspect.SquaresOutposts = die Schlüsselfelder und Vorposten
aspect.Space = den Raum
aspect.Development = die Entwicklung
aspect.Initiative = die Initiative

imbalance.PawnStructure.minor = Die Bauernstruktur von {beneficiary} ist etwas günstiger.
imbalance.PawnStructure.clear = {beneficiary} hat die bessere Bauernstruktur.
imbalance.PawnStructure.winning = Die überlegene Bauernstruktur von {beneficiary} dürfte die Partie entscheiden.
imbalance.PawnStructure.clear.endgame = Im Endspiel wiegt die bessere Bauernstruktur von {beneficiary} besonders schwer.
imbalance.PawnStructure.winning.endgame = Im Endspiel sollte die Bauernstruktur von {beneficiary} entscheidend sein.

imbalance.MinorPieces.minor = Die Leichtfiguren von {beneficiary} stehen etwas besser.
imbalance.MinorPieces.clear = {beneficiary} hat die besser platzierten Leichtfiguren.
imbalance.MinorPieces.winning = Die Leichtfiguren von {beneficiary} beherrschen das Brett.

imbalance.Material.minor = {beneficiary} hat einen kleinen Materialvorteil.
imbalance.Material.clear = {beneficiary} hat Materialvorteil.
imbalance.Material.winning = {beneficiary} hat einen entscheidenden Materialvorteil.
imbalance.Material.winning.endgame = Im Endspiel dürfte das Mehrmaterial von {beneficiary} die Entscheidung bringen.

imbalance.FilesDiagonals.minor = {beneficiary} hat etwas mehr Einfluss auf die offenen Linien.
imbalance.FilesDiagonals.clear = {beneficiary} kontrolliert die wichtigen Linien.
imbalance.FilesDiagonals.winning = {beneficiary} beherrscht die offenen Linien nahezu vollständig.

imbalance.SquaresOutposts.minor = {beneficiary} hat einen kleinen Vorteil im Kampf um die Schlüsselfelder.
imbalance.SquaresOutposts.clear = {beneficiary} kontrolliert die wichtigen Felder.
imbalance.SquaresOutposts.winning = Die Kontrolle der Schlüsselfelder durch {beneficiary} ist entscheidend.

imbalance.Space.minor = {beneficiary} verfügt über etwas mehr Raum.
imbalance.Space.clear = {beneficiary} hat einen deutlichen Raumvorteil.
imbalance.Space.winning = Der Raumvorteil von {beneficiary} engt den Gegner entscheidend ein.

imbalance.Development.minor = {beneficiary} ist in der Entwicklung leicht voraus.
imbalance.Development.clear = {beneficiary} hat einen deutlichen Entwicklungsvorsprung.
imbalance.Development.winning = Der Entwicklungsvorsprung von {beneficiary} ist entscheidend.

# Development prior (run 11): unfinished development is a to-do list for
# {beneficiary}, never an advantage claim — the who-is-ahead story stays
# with the plain Development keys above.
imbalance.Development.todo.minor = {beneficiary} muss die Entwicklung noch etwas vervollständigen.
imbalance.Development.todo.clear = Die Entwicklung von {beneficiary} ist noch unvollständig.

imbalance.Initiative.minor = {beneficiary} hat eine leichte Initiative.
imbalance.Initiative.clear = {beneficiary} besitzt die Initiative und bestimmt das Geschehen.
imbalance.Initiative.winning = Die Initiative von {beneficiary} hat entscheidende Ausmaße erreicht.

# Balanced verdicts and generic fallbacks.
imbalance.balanced = Hinsichtlich {aspect} ist die Stellung ausgeglichen.
imbalance.generic.minor = {beneficiary} steht bei {aspect} etwas besser.
imbalance.generic.clear = {beneficiary} hat bei {aspect} einen klaren Vorteil.
imbalance.generic.winning = Der Vorteil von {beneficiary} bei {aspect} scheint entscheidend.
