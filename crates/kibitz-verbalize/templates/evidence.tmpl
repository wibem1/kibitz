# evidence.tmpl — grammatical renderings for imbalance evidence keys.
# Every rendering is a full clause (no terminal period; the composing code
# capitalizes it and adds the period). Slots:
#   {side}   — "White"/"Black", from the key suffix, the value, or the FEN
#   {items}  — squares joined ("d5", "c4 and d5")
#   {files}  — a ready file phrase ("the d-file", "the d- and e-files")
#   {square} — a single square ("f8")
#   {pawns}  — a joined square list ("c5 and d6")
# Keys the code does not recognize are omitted from the prose entirely —
# raw evidence data must never leak into a sentence. Bare counts
# (locked_center_pawns, space, development, forcing moves) are folded into
# qualitative phrasing or suppressed by the code; they never appear as
# labeled numbers.

# Presentation order for evidence keys within one imbalance sentence,
# by base key (side suffixes stripped). Unlisted keys come last.
evidence.order = passed|isolated|doubled|backward|hanging|queenside_majority|kingside_majority|bishop_pair|bad_bishop|character|pattern|material_diff_cp|open_files|half_open_files|doubled_majors|rook_on_seventh|holes|established_outpost|sleeping_minors|king_in_center|queen_sortie|wanderer|center_unclaimed

# Pawn-structure weaknesses and assets. The .neutral variants are used
# when no owner can be established from the key or the FEN.
evidence.isolated = {side} hat auf {items} einen isolierten Bauern
evidence.isolated.plural = die Bauern von {side} auf {items} sind isoliert
evidence.isolated.neutral = der Bauer auf {items} ist isoliert
evidence.isolated.neutral.plural = die Bauern auf {items} sind isoliert

evidence.doubled = {side} hat einen Doppelbauern auf {items}
evidence.doubled.plural = die Bauern von {side} auf {items} bilden Doppelbauern
evidence.doubled.neutral = der Bauer auf {items} gehört zu einem Doppelbauern
evidence.doubled.neutral.plural = die Bauern auf {items} bilden Doppelbauern

evidence.backward = der Bauer von {side} auf {items} ist rückständig
evidence.backward.plural = die Bauern von {side} auf {items} sind rückständig
evidence.backward.neutral = der Bauer auf {items} ist rückständig
evidence.backward.neutral.plural = die Bauern auf {items} sind rückständig

evidence.passed = {side} hat einen Freibauern auf {items}
evidence.passed.plural = {side} hat Freibauern auf {items}
evidence.passed.neutral = auf {items} steht ein Freibauer
evidence.passed.neutral.plural = auf {items} stehen Freibauern

evidence.hanging = {side} hat einen hängenden Bauern auf {items}
evidence.hanging.plural = die Bauern von {side} auf {items} sind hängend
evidence.hanging.neutral = auf {items} steht ein hängender Bauer
evidence.hanging.neutral.plural = auf {items} stehen hängende Bauern

evidence.queenside_majority = {side} hat eine Bauernmehrheit am Damenflügel
evidence.kingside_majority = {side} hat eine Bauernmehrheit am Königsflügel

# Minor pieces.
evidence.bishop_pair = {side} besitzt das Läuferpaar
evidence.bishop_pair.open = {side} verfügt in offener Stellung über das Läuferpaar
evidence.bad_bishop = der Läufer von {side} auf {square} wird durch die eigenen Bauern auf {pawns} eingeschränkt
evidence.bad_bishop.bare = der Läufer von {side} auf {square} wird durch eigene Bauern eingeschränkt
evidence.character.closed = die Stellung hat ein geschlossenes Zentrum

# Material. The raw centipawn figure is folded into pawn language; named
# patterns take precedence over the figure.
evidence.material.pawn_up = {side} hat einen Bauern mehr
evidence.material.two_pawns_up = {side} hat zwei Bauern mehr
evidence.material.three_pawns_up = {side} hat drei Bauern mehr
evidence.material.many_pawns_up = {side} hat entscheidenden Materialvorteil
evidence.pattern.white-exchange-up = Weiß hat die Qualität mehr
evidence.pattern.black-exchange-up = Schwarz hat die Qualität mehr

# Files and the seventh rank.
evidence.open_files = {files} ist offen
evidence.open_files.plural = {files} sind offen
evidence.half_open_files = {files} ist für {side} halboffen
evidence.half_open_files.plural = {files} sind für {side} halboffen
evidence.half_open_files.neutral = {files} ist halboffen
evidence.half_open_files.neutral.plural = {files} sind halboffen
evidence.doubled_majors = {side} hat die Schwerfiguren auf {files} verdoppelt
evidence.rook_on_seventh = {side} hat einen Turm auf der siebten Reihe

# Squares and outposts. For holes, {side} is the side whose camp has them.
evidence.holes = in der Stellung von {side} gibt es ein schwaches Feld auf {items}
evidence.holes.plural = in der Stellung von {side} gibt es schwache Felder auf {items}
evidence.established_outpost = der Springer von {side} hat auf {items} einen festen Vorposten

# Development prior (run 11): the classical principles as evidence.
# The piece mix (knights/bishops/mixed) is resolved from the FEN.
evidence.sleeping_minors.one_knight = der Springer von {side} auf {items} ist noch nicht entwickelt
evidence.sleeping_minors.one_bishop = der Läufer von {side} auf {items} ist noch nicht entwickelt
evidence.sleeping_minors.one = die Leichtfigur von {side} auf {items} ist noch nicht entwickelt
evidence.sleeping_minors.knights = die Springer von {side} auf {items} stehen noch auf ihren Ausgangsfeldern
evidence.sleeping_minors.bishops = die Läufer von {side} auf {items} stehen noch auf ihren Ausgangsfeldern
evidence.sleeping_minors.mixed = die Leichtfiguren von {side} auf {items} sind noch nicht entwickelt
evidence.sleeping_minors.plural = die Leichtfiguren von {side} auf {items} sind noch nicht entwickelt
evidence.king_in_center.available = der König von {side} steht noch im Zentrum, kann aber noch rochieren
evidence.king_in_center.lost = der König von {side} steckt im Zentrum fest und darf nicht mehr rochieren
evidence.queen_sortie = die Dame von {side} steht schon auf {items}, obwohl die Leichtfiguren noch nicht entwickelt sind
evidence.wanderer = die Figur von {side} auf {square} wurde bereits {times} gezogen, während die Entwicklung zurücksteht
evidence.center_unclaimed = {side} hat das Zentrum noch nicht besetzt; der Vorstoß nach {items} ist noch möglich
evidence.center_unclaimed.plural = {side} hat das Zentrum noch nicht besetzt; Vorstöße nach {items} sind noch möglich

# Material in piece terms (run 9): a won knight is not "three pawns".
evidence.material.piece_up = {side} hat eine Figur mehr
evidence.material.piece_for_pawn = {side} hat eine Figur für einen Bauern
evidence.material.piece_for_pawns = {side} hat eine Figur für zwei Bauern
evidence.material.rook_up = {side} hat einen Turm mehr
evidence.material.queen_up = {side} hat eine Dame mehr
