# alerts.tmpl — lead sentences for WSUI tactical alerts. Slots: {subject}
# is a full noun phrase built from the record ("Black's knight on c6",
# "White's king"); {target_clause} is used by WeakKing only and is either
# empty or " around <square>"; {defenders} (overload lead only) is the
# joined list of pieces the overloaded piece defends.
#
# Lookup order per alert: `alert.<Kind>.<detail>` first (which absorbs the
# detail into the lead), then `alert.<Kind>.<severity>`, then the generic.

alert.Undefended.high = {subject} ist ungedeckt und unmittelbar gefährdet.
alert.Undefended.medium = {subject} ist ungedeckt.
alert.Undefended.low = {subject} ist momentan nicht gedeckt; das sollte man im Blick behalten.
alert.Undefended.loose = {subject} steht ohne Deckung da.
alert.Undefended.attacked-and-undefended = {subject} ist angegriffen und ungedeckt.

# The detector fires on a POSITIVE static exchange: the capture sequence
# on this square wins material. That is a threat to be answered, not a
# remark about defensive density — say what is at stake and what answers
# it (2026-08-02 field report: "it's calling for defense? More like it's
# being attacked").
alert.InadequatelyDefended.high = Ein Schlag auf {subject} gewinnt Material. Die Figur sollte ziehen, besser gedeckt oder der Angreifer beseitigt werden.
alert.InadequatelyDefended.medium = Beim Schlag auf {subject} entsteht Materialverlust. Die Figur sollte ausweichen, zusätzliche Deckung erhalten oder den Angreifer schlagen.
alert.InadequatelyDefended.low = Der Schlagabtausch um {subject} begünstigt momentan leicht den Angreifer.

# Pure overload alerts (the subject is itself the overworked defender).
alert.overloaded = {subject} ist überlastet und deckt als einzige Figur {defenders}.

alert.TrappedPiece.high = {subject} ist gefangen und hat kein sicheres Fluchtfeld.
alert.TrappedPiece.medium = {subject} hat gefährlich wenige sichere Felder.
alert.TrappedPiece.low = {subject} hat nur wenig Bewegungsfreiheit.
alert.TrappedPiece.trapped-and-attacked = {subject} ist angegriffen und hat kein sicheres Fluchtfeld.
alert.TrappedPiece.trapped-attackable = {subject} hat keinen sicheren Rückzug mehr; die Falle droht zuzuschnappen.

alert.WeakKing.high = {subject} ist ernsthaft gefährdet{target_clause}.
alert.WeakKing.medium = {subject} steht nicht ganz sicher{target_clause}.
alert.WeakKing.low = {subject} zeigt leichte Schwächen{target_clause}.

# Fallback for alert kinds this file does not know yet.
alert.generic = {subject} verdient taktische Aufmerksamkeit{target_clause}.

# .alt variants — deterministic phrasing variety keyed off the target
# square, so consecutive same-kind alerts on different squares do not read
# as copy-paste (run-5 feedback item 2).
alert.Undefended.medium.alt = {subject} steht derzeit ohne Deckung.
alert.InadequatelyDefended.medium.alt = Die Angreifer auf {subject} überfordern die Verteidigung.
alert.InadequatelyDefended.high.alt = Die Verteidigung von {subject} hält dem Angriff nicht stand.
