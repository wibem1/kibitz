# common.tmpl — shared vocabulary, clauses and rotations for the template
# verbalizer. Format: one `key = template` per line, `{slot}` placeholders,
# `#` starts a comment. Leading/trailing whitespace around key and value is
# trimmed; spacing between fragments is supplied by the composing code.

# Side and piece vocabulary.
side.white = Weiß
side.black = Schwarz
piece.pawn = Bauer
piece.knight = Springer
piece.bishop = Läufer
piece.rook = Turm
piece.queen = Dame
piece.king = König
# Fallback when the record names a square the FEN has nothing on.
piece.generic = Figur

# Noun phrases for pieces and squares.
# {side} / {piece} / {square} are always taken from the record (square lists)
# or derived from the record's FEN (piece identity and color).
phrase.owned_piece = {piece} von {side} auf {square}
phrase.bare_piece = {piece} auf {square}
phrase.unknown_piece = Figur auf {square}
phrase.side_piece = Figur von {side} auf {square}
phrase.some_piece = eine Figur von {side}
phrase.kings = König von {side}

# File phrases. {items} for the plural form is the pre-hyphenated joined
# list ("d- and e-"), so the result reads "the d- and e-files".
phrase.file = die {items}-Linie
phrase.files = die {items}Linien

# Alert body clauses.
clause.weak_king_target = im Bereich von {target}
clause.attacked_by = Die Angreifer sind {attackers}.
clause.attack_defend.both = Die Angreifer sind {attackers}; die Verteidiger sind lediglich {defenders}.
clause.attack_defend.both.alt = Dem Angriff durch {attackers} stehen nur {defenders} gegenüber.
clause.attack_defend.attackers = Die Angreifer sind {attackers}; eine Deckung fehlt.
clause.attack_defend.defenders = Nur {defenders} sorgt für Deckung.
clause.attack_defend.defenders.plural = Nur {defenders} sorgen für Deckung.
clause.king_attackers = Der Druck geht von {attackers} aus.
clause.see = Eine Schlagfolge gewinnt hier {amount}.
clause.see.alt = Nach Beginn des Schlagabtauschs gewinnt der Angreifer {amount}.

# Weak-king detail clauses, joined into one sentence by the code.
king.zone_pressure = gegnerische Figuren sammeln sich in seiner Nähe
king.shield_missing = der Bauernschutz auf {files} fehlt
king.shield_advanced = der Schutzbauer auf {files} ist zu weit vorgerückt
king.shield_advanced.plural = die Schutzbauern auf {files} sind zu weit vorgerückt
king.open_files = {files} vor dem König ist vollständig offen
king.open_files.plural = {files} vor dem König sind vollständig offen
king.back_rank = die Grundreihe ist verwundbar

# Static-exchange value bands (centipawns -> plain words).
see.small = etwas Material
see.pawn = ungefähr einen Bauern
see.two_pawns = etwa zwei Bauern
see.minor = ungefähr eine Leichtfigur
see.rook = ungefähr einen Turm
see.queen = ungefähr eine Dame

# Units for engine score deltas.
unit.pawn = Bauer
unit.pawns = Bauern

# Engine-check verdicts attached to an alert.
engine.confirmed.pv_delta = Die Engine bestätigt: {pv}, mit einem Gewinn von etwa {delta}.
engine.confirmed.pv = Die Engine bestätigt: {pv}.
engine.confirmed.delta = Die Engine bestätigt die Idee mit einem Gewinn von etwa {delta}.
engine.confirmed = Die Engine bestätigt diese Idee.
engine.confirmed.pv_mate = Die Engine bestätigt: {pv} — erzwungenes Matt in {mate} Zügen.
engine.confirmed.mate = Die Engine bestätigt ein erzwungenes Matt in {mate} Zügen.
engine.confirmed.pv_mate_now = Die Engine bestätigt: {pv} — Schachmatt.
engine.confirmed.mate_against = Die Engine kommt zum gegenteiligen Ergebnis: Die verteidigende Seite setzt in {mate} Zügen matt.
engine.refuted = Die Engine widerlegt die Idee: Die Verteidigung scheint zu halten.
engine.unclear = Die Engine konnte die Idee innerhalb des Suchbudgets nicht bestätigen.

# Whole-position engine verdict (only present when an engine actually ran).
engine.eval = Gesamtbewertung der Engine: etwa {score}; sie bevorzugt {best}.
engine.eval.mate = Die Engine erkennt ein erzwungenes Matt in {mate} Zügen für {side}; der Zug ist {best}.

# Known alert detail qualifiers, phrased as complete follow-on sentences.
# The trapped/loose tokens are absorbed into the lead sentence instead
# (alerts.tmpl); unknown tokens fall back to clause.detail, humanized.
detail.overloaded-defender = Diese Verteidigungsfigur ist überlastet und kann nicht alles gleichzeitig decken.
detail.back-rank = Die eigene Grundreihe weist eine ernsthafte Schwäche auf.
detail.pawn-shield = Der Bauernschutz des Königs ist beschädigt.
clause.detail = Das grundlegende Problem ist {detail}.

# Section-level lines.
tactics.quiet = Eine unmittelbare taktische Drohung ist nicht erkennbar; langfristige Stellungsmerkmale sind entscheidend.
empty = Keine akuten taktischen Gefahren und keine deutlichen Ungleichgewichte. Verbessere die am schlechtesten stehende Figur.

# Deterministic sentence-start rotations, applied by index (i % n).
# Entries are separated by `|`; the first entry is intentionally empty.
rotation.alert = |Außerdem:|Hinzu kommt:|Ebenfalls wichtig:
rotation.imbalance = |Außerdem:|Gleichzeitig:|Darüber hinaus:

# List glue (code pads with spaces as needed).
glue.list_sep = ,
glue.list_last = und

# Spelled-out repetition counts (the template lint bans bare digits).
count.twice = zweimal
count.three_times = dreimal
count.many_times = mehrmals

# Openings-book line (run 11): shown while the position is still in the
# bundled openings book — theory outranks a principles lecture there.
book.in_theory = Diese Stellung ist noch aus der Eröffnungstheorie bekannt.

# Decisive band (run-6): at or above 5 pawns of advantage the prose gives
# a verdict; the exact number stays in the eval readout.
engine.confirmed.pv_decisive = Die Engine bestätigt: {pv} — die Stellung ist klar gewonnen.
engine.confirmed.decisive = Die Engine bestätigt: Die Stellung ist klar gewonnen.
engine.eval.decisive = Engine-Bewertung: klar gewonnen für {side}; bevorzugt wird {best}.
