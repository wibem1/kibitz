# schemes.tmpl — multi-stage plans read out IN ORDER (record schema v4).
#
# A scheme is the long-horizon voice: not "a good plan is X" but "here is
# the sequence, and here is what has to happen first". Slots:
#   {side}    "White" / "Black"
#   {target}  the square the whole plan is about
#   {horizon} total moves, e.g. "about four moves"
#   {steps}   the stages, already joined
# Step slots: {piece} {agent} {to} {route} {targets} {via_clause}

scheme.lead = Langfristiger Plan für {side} rund um {target}{horizon_clause}: {steps}.
scheme.lead.more = Ein weiterer langfristiger Plan für {side} rund um {target}{horizon_clause}: {steps}.
scheme.horizon_clause =  (etwa {horizon})
# The store trims values, so the separating space is added in code.
scheme.join = ;

# Stage 1 — clear the way.
scheme.step.clear = zuerst müssen {targets} abgetauscht werden
# How a blocker is named: the piece, not a bare square.
scheme.target_piece = {piece} auf {square}
scheme.step.clear.by = zuerst {targets} abtauschen; dazu kann {piece} auf {agent} beitragen{via_clause}
scheme.step.clear.via_clause = , über {via}

# Stage 2 — the way in. The first is the plan; the rest are alternatives.
scheme.step.maneuver = danach {piece} nach {to} führen ({route})
scheme.step.maneuver.alt = alternativ {piece} von {agent} einsetzen ({route})

# Stage 3 — what the square is for. Falls back to the plan.* wording.
scheme.step.exploit = anschließend {plan}

# Nothing has to happen first, but somebody still has to be able to.
scheme.step.clear.nobody = zunächst müssen {targets} beseitigt werden; derzeit ist das mit den eigenen Figuren nicht möglich

# A maneuver no scheme picked up still deserves saying — otherwise a
# record can hold a plan the reader never hears about.
maneuver.lead = Ein beachtenswerter Zug für {side}: {clause}.
maneuver.opposition = mit dem König die Opposition übernehmen: {from}–{to}
maneuver.generic = {piece} von {from} nach {to} führen
