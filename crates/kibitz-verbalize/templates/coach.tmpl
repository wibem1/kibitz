# coach.tmpl — the "Kibitz voice" (run-5 item 3): an anthropomorphized-piece
# coaching OVERLAY on the base templates. When the Coach voice is selected,
# every lookup first tries `coach.<key>` from this file and falls back to the
# plain `<key>`; the Neutral voice never reads this file. So this file only
# carries the lines where the coaching voice genuinely improves on the
# neutral phrasing — alert leads, imbalance leads, plan leads — and every
# slot works exactly as in the base template of the same name.
#
# Style contract: pieces have desires and grievances (a knight dreams of an
# outpost, a bishop bites on granite), the student may be addressed directly
# but only sparingly, and the voice may never add a chess fact the record
# does not contain. Vivid but concrete, never cute for its own sake.
#
# A key with a coach override uses only its own `coach.<key>.alt` for the
# seeded phrasing variety; base .alt variants do not mix into coach prose.

# --- Tactical alert leads (see alerts.tmpl for slots) ---
coach.alert.Undefended.high = {subject} wurde regelrecht im Stich gelassen: Keine Figur deckt es.
coach.alert.Undefended.medium = {subject} steht ganz allein; niemand übernimmt die Deckung.
coach.alert.Undefended.medium.alt = Um {subject} kümmert sich zurzeit keine eigene Figur.
coach.alert.Undefended.low = {subject} ist momentan auf sich gestellt. Behalte es im Auge.
coach.alert.Undefended.loose = {subject} steht ohne Deckung da. Das könnte wichtig werden.
coach.alert.Undefended.attacked-and-undefended = {subject} ist angegriffen, doch kein Verteidiger hilft.

# See the note in alerts.tmpl: this alert means the exchange on the square
# wins material, so the coach voice names the threat and the three replies
# to it rather than admiring the defence.
coach.alert.InadequatelyDefended.high = {subject} ist eine leichte Beute. Zieh die Figur weg, decke sie oder beseitige den Angreifer.
coach.alert.InadequatelyDefended.high.alt = Der Gegner kann {subject} mit Materialgewinn schlagen. Wegziehen, verstärken oder den Angreifer beseitigen.
coach.alert.InadequatelyDefended.medium = Ein Schlag auf {subject} kostet Material. Ziehe die Figur weg, verstärke die Deckung oder schlage den Angreifer.
coach.alert.InadequatelyDefended.medium.alt = Beim Schlagabtausch um {subject} steht der Gegner besser da. Sorge für zusätzliche Deckung.
coach.alert.InadequatelyDefended.low = Der Schlagabtausch um {subject} begünstigt den Angreifer etwas. Prüfe das vor dem nächsten Zug.

coach.alert.overloaded = {subject} muss zu viele Aufgaben übernehmen und deckt allein {defenders}.

coach.alert.TrappedPiece.high = {subject} sitzt in der Falle und erreicht kein einziges sicheres Feld mehr.
coach.alert.TrappedPiece.medium = {subject} hat kaum noch Luft; die sicheren Felder werden knapp.
coach.alert.TrappedPiece.low = {subject} wird eingeengt und hat nur wenig Bewegungsfreiheit.
coach.alert.TrappedPiece.trapped-and-attacked = {subject} ist angegriffen und gefangen. Ein sicherer Rückzug ist nicht mehr möglich.
coach.alert.TrappedPiece.trapped-attackable = {subject} hat keinen Ausweg; die Falle kann jederzeit zuschnappen.

coach.alert.WeakKing.high = {subject} steht schwer unter Druck{target_clause}; sein Schutz ist zusammengebrochen.
coach.alert.WeakKing.medium = {subject} ist verwundbar{target_clause}; seine Deckung weist Lücken auf.
coach.alert.WeakKing.low = {subject} hat leichte Sicherheitsprobleme{target_clause}. Behalte sie im Auge.

# --- Section-level lines (common.tmpl) ---
coach.tactics.quiet = Keine unmittelbare Taktik drängt sich auf. Jetzt zählen die langfristigen Stellungsmerkmale.
coach.empty = Keine akute Gefahr und keine deutlichen Vorteile. Such die am schlechtesten stehende Figur und verbessere ihre Stellung.

# --- Known alert detail follow-ons (common.tmpl) ---
coach.detail.overloaded-defender = Diese Verteidigungsfigur ist überlastet; sie kann nicht an zwei Orten zugleich helfen.

# --- Imbalance headlines (imbalances.tmpl; slots {beneficiary}, {aspect}) ---
coach.imbalance.PawnStructure.minor = Die Bauernstruktur von {beneficiary} hat etwas weniger Schwächen.
coach.imbalance.PawnStructure.clear = Die Bauernstruktur von {beneficiary} ist deutlich gesünder. Die gegnerischen Schwächen bleiben bestehen.
coach.imbalance.PawnStructure.winning = Die Bauernstruktur von {beneficiary} könnte allein den Ausschlag geben; die Schwächen des Gegners verschwinden nicht.

coach.imbalance.MinorPieces.minor = Die Leichtfiguren von {beneficiary} haben etwas angenehmere Felder gefunden.
coach.imbalance.MinorPieces.clear = Die Leichtfiguren von {beneficiary} sind aktiv, während ihre Gegenstücke noch nach Aufgaben suchen.
coach.imbalance.MinorPieces.winning = Die Leichtfiguren von {beneficiary} beherrschen das Brett; der Gegner kann kaum dagegenhalten.

coach.imbalance.Material.winning = {beneficiary} hat genug Material gewonnen, um die Partie bei sauberem Spiel zu entscheiden.

coach.imbalance.FilesDiagonals.clear = Die Schwerfiguren von {beneficiary} verfügen über die wichtigen offenen Linien.
coach.imbalance.FilesDiagonals.winning = Alle entscheidenden Linien gehören {beneficiary}; die gegnerischen Figuren sind stark eingeschränkt.

coach.imbalance.SquaresOutposts.minor = {beneficiary} gewinnt langsam den Kampf um die wichtigen Felder.
coach.imbalance.SquaresOutposts.clear = {beneficiary} beherrscht die entscheidenden Felder und kann seine Figuren dort dauerhaft aufstellen.
coach.imbalance.SquaresOutposts.winning = {beneficiary} kontrolliert die Schlüsselfelder vollständig; dem Gegner fehlen gute Standorte.

coach.imbalance.Space.minor = Die Figuren von {beneficiary} haben etwas mehr Bewegungsfreiheit.
coach.imbalance.Space.clear = Die Figuren von {beneficiary} können frei spielen, während sich die gegnerischen Figuren gegenseitig behindern.
coach.imbalance.Space.winning = Der Raumvorteil von {beneficiary} schnürt den Gegner immer weiter ein.

coach.imbalance.Development.clear = Die Figuren von {beneficiary} sind schon im Spiel; die des Gegners stehen noch auf ihren Ausgangsfeldern.
coach.imbalance.Development.winning = {beneficiary} hat die Entwicklung weitgehend abgeschlossen, während der Gegner noch zurückliegt.

# Development prior (run 11): dreams under uncertainty, never a rulebook.
coach.imbalance.Development.todo.minor = Die Figuren von {beneficiary} sind fast alle entwickelt. Einzelne warten noch auf eine Aufgabe.
coach.imbalance.Development.todo.clear = Bei {beneficiary} stehen noch viele Figuren auf der Grundreihe. Zuerst entwickeln!

coach.imbalance.Initiative.clear = {beneficiary} stellt die Fragen; der Gegner muss Antworten finden.
coach.imbalance.Initiative.winning = Die Initiative von {beneficiary} ist überwältigend. Jeder Zug schafft neue Drohungen.

# --- Selected evidence clauses (evidence.tmpl; no terminal period) ---
coach.evidence.bad_bishop = der Läufer von {side} auf {square} beißt auf Granit; eigene Bauern auf {pawns} versperren seine Wege
coach.evidence.bad_bishop.bare = der Läufer von {side} auf {square} ist durch die eigene Bauernkette eingesperrt
coach.evidence.established_outpost = der Springer von {side} hat auf {items} einen dauerhaften Vorposten gefunden
coach.evidence.holes = auf {items} klafft in der Stellung von {side} ein schwaches Feld, das der Gegner besetzen könnte
coach.evidence.holes.plural = auf {items} gibt es in der Stellung von {side} schwache Felder, die gegnerischen Figuren als Vorposten dienen könnten

# --- Development-prior evidence (run 11) ---
coach.evidence.sleeping_minors.mixed = die Leichtfiguren auf {items} warten noch auf ihre Entwicklung; vor allem die Läufer brauchen offene Diagonalen
coach.evidence.sleeping_minors.knights = die Springer von {side} auf {items} warten noch darauf, ins Spiel zu kommen
coach.evidence.sleeping_minors.bishops = die Läufer von {side} auf {items} warten noch auf offene Diagonalen
coach.evidence.sleeping_minors.one_knight = der Springer von {side} auf {items} steht noch auf seinem Ausgangsfeld
coach.evidence.sleeping_minors.one_bishop = der Läufer von {side} auf {items} steht noch auf seinem Ausgangsfeld
coach.evidence.king_in_center.available = der König von {side} steht noch mitten im Zentrum; die Rochade ist aber möglich
coach.evidence.king_in_center.lost = der König von {side} hat das Rochaderecht verloren und muss im Zentrum ausharren
coach.evidence.queen_sortie = die Dame von {side} ist bereits nach {items} gezogen; gegnerische Entwicklungszüge könnten sie mit Tempo angreifen
coach.evidence.wanderer = die Figur von {side} auf {square} wurde schon {times} gezogen, während andere Figuren noch auf der Grundreihe stehen
coach.evidence.center_unclaimed = das Zentrum ist noch unbesetzt; {side} kann mit dem Vorstoß nach {items} Einfluss gewinnen
coach.evidence.center_unclaimed.plural = das Zentrum ist noch unbesetzt; {side} kann mit Vorstößen nach {items} Einfluss gewinnen

# --- Plan leads and selected plan phrases (plans.tmpl) ---
coach.plan.lead.side = Darauf sollte {side} hinarbeiten: {plan}{squares_clause}.
coach.plan.lead.side.more = Ein weiterer Gedanke für {side}: {plan}{squares_clause}.
coach.plan.lead.neutral = Diesen Plan solltest du beachten: {plan}{squares_clause}.
coach.plan.lead.neutral.more = Eine weitere Idee für später: {plan}{squares_clause}.

coach.plan.BlockadeThenPressure = eine Figur vor den schwachen Bauern stellen, ihn blockieren und dann mehrfach angreifen
coach.plan.OpenThePosition = einen Bauernhebel suchen, der die Stellung öffnet
coach.plan.EscortThePasser = den König als Begleiter des Freibauern heranführen
coach.plan.PushThePasser = den Freibauern vorantreiben, solange der Weg frei ist
coach.plan.ManeuverKnight = dem Springer sein bestes Feld verschaffen
coach.plan.ManeuverKnightToOutpost = den Springer auf seinen dauerhaften Vorposten führen
coach.plan.UndermineDefender = den Bauern angreifen, der das gewünschte Feld schützt
coach.plan.CreatePassedPawn = die Bauernmehrheit vorziehen und daraus einen Freibauern bilden
coach.plan.HuntBishopPair = dem Gegner einen Läufer im Tausch gegen einen Springer abnehmen
coach.plan.TradeSquareDefender = die Figur abtauschen, die das gewünschte Feld bewacht
coach.plan.TargetWeakPawn = den schwachen Bauern zum Angriffsziel machen, da kein anderer Bauer ihn decken kann
coach.plan.AttackWhereYouAreStronger = dort angreifen, wo tatsächlich mehr eigene Figuren eingreifen können
coach.plan.KeepBestPiece = die beste eigene Figur behalten und den Plan auf sie ausrichten
coach.plan.TradeOffAttacker = die gefährlichste gegnerische Angriffsfigur abtauschen
coach.plan.OverprotectStrongPoint = den wichtigen Stützpunkt stärker decken, als unmittelbar nötig scheint
coach.plan.ManeuverBishopToSupportPoint = den Läufer zu dem Stützpunkt führen, den der eigene Bauer sichert
coach.plan.ManeuverRookToOpenFile = den Turm auf die offene Linie stellen; dort kann er aktiv werden
coach.plan.TradePieces = Figuren abtauschen, damit die beengte Stellung wieder Luft bekommt
coach.plan.PrepareBreak = einen befreienden Bauernhebel vorbereiten
coach.plan.KeepPositionClosed = die Stellung geschlossen halten, damit die Springer die Läufer übertreffen
coach.plan.OpenPositionForBishops = die Stellung öffnen, damit die Läufer ihre Diagonalen nutzen können
coach.plan.AdvanceQueensideMajority = die Bauernmehrheit am Damenflügel vorantreiben
coach.plan.BlockadeWhitePasser = dem weißen Freibauern mit einer Blockadefigur den Weg versperren
coach.plan.BlockadeBlackPasser = dem schwarzen Freibauern mit einer Blockadefigur den Weg versperren
coach.plan.DoubleOnOpenFile = die Schwerfiguren auf der offenen Linie verdoppeln und dort Druck entwickeln
coach.plan.UseSpaceAvoidExchanges = den Raumvorteil bewahren und Figurentausch vermeiden
coach.plan.OpenPositionBeforeOpponentCompletes = die Stellung öffnen, solange der Gegner seine Entwicklung noch nicht abgeschlossen hat
coach.plan.WingPawnStormClosedCenter = bei geschlossenem Zentrum die Flügelbauern zum Angriff vorziehen
coach.plan.MinorityAttack = mit der Bauernminderheit angreifen, um eine bleibende Schwäche zu schaffen
coach.plan.RookToSeventh = den Turm auf die siebte Reihe bringen, wo er die gegnerischen Bauern angreift
coach.plan.RookBehindPasser = den Turm hinter den Freibauern stellen und seinen Vormarsch unterstützen
coach.plan.PressureBackwardPawn = den rückständigen Bauern dauerhaft unter Druck setzen
coach.plan.PressureDoubledPawn = den vorderen Doppelbauern angreifen, den kein anderer Bauer decken kann
coach.plan.TradeOrActivateBadBishop = den schlechten Läufer abtauschen oder außerhalb der Bauernkette aktivieren
coach.plan.ActivateKingInEndgame = den König im Endspiel aktivieren und ins Zentrum führen
coach.plan.RestrictKnight = dem gegnerischen Springer jeden dauerhaften Vorposten verwehren
coach.plan.ActivateEntombedPiece = die eingeschlossene Figur befreien oder abtauschen
coach.plan.KeepPieceEntombed = die gegnerische Figur eingeschlossen lassen und keine befreienden Bauernzüge erlauben
coach.plan.UprootBlockader = die Blockadefigur angreifen und vertreiben; dann kann der Freibauer wieder laufen
coach.plan.ChooseBlockader = den Springer als Blockadefigur wählen, denn von dort bleibt er aktiv
coach.plan.AlternateTargets = abwechselnd zwei Schwächen angreifen, bis die gegnerische Verteidigung überfordert ist
coach.plan.OutsidePasserDecoy = den entfernten Freibauern als Ablenkung einsetzen, damit der gegnerische König den anderen Flügel verlassen muss
coach.plan.AdvanceCentralMajority = die zentrale Bauernmehrheit vorziehen und möglichst einen Freibauern bilden
coach.plan.OpenLinesTowardWeakKing = Linien zum gefährdeten König öffnen und die Schwerfiguren einsetzen
coach.plan.CompleteDevelopment = die übrigen Figuren entwickeln, bevor ein Angriff beginnt
coach.plan.CastleIntoSafety = den König durch Rochade sichern und den Turm aktivieren
coach.plan.ClaimTheCenter = das Zentrum mit den eigenen Bauern besetzen, solange es möglich ist
coach.plan.QueenAheadOfHerArmy = die früh entwickelte Dame zurückführen, bevor der Gegner sie mit Tempo angreift
coach.plan.SamePieceWandering = die bereits oft gezogene Figur ruhen lassen und endlich eine andere entwickeln

# --- Composite plans (plans.tmpl; slots {target}, {clauses}, {side}) ---
coach.plan.composite.lead = Die Stellung weist auf ein Ziel: {target}. Dafür sprechen {clauses}.
coach.plan.composite.runner_up = {side} hat rund um {target} noch eine weitere Möglichkeit.

# --- Candidate-move closing (run 10; plans.tmpl slots) ---
coach.suggest.close = Mein Vorschlag: {first}. Dieser Zug unterstützt {n} Pläne; {second} ist die Alternative.
coach.suggest.close.solo = Mein Vorschlag: {first}. Dieser Zug unterstützt {n} Pläne.
coach.suggest.close.one = Mein Vorschlag: {first} bringt den Hauptplan voran; {second} ist die Alternative.
coach.suggest.close.one.solo = Mein Vorschlag: {first} bringt den Hauptplan voran.
coach.suggest.prophylactic = Zuerst dem Gegner zuvorkommen: Er will {their_plan}; {first} verhindert diese Idee.

# --- Openings-book line (run 11; common.tmpl base key) ---
coach.book.in_theory = Noch Eröffnungstheorie: Diese Stellung ist bereits gut untersucht.

# --- Scheme leads and stages (schemes.tmpl) ---
coach.scheme.lead = Der langfristige Plan für {side}: das Feld {target} besetzen{horizon_clause} — {steps}.
coach.scheme.lead.more = {side} kann auch langfristig um {target} spielen{horizon_clause}: {steps}.
coach.scheme.step.clear = zunächst müssen {targets} verschwinden
coach.scheme.step.clear.by = zunächst {targets} beseitigen; die Figur {piece} auf {agent} kann das übernehmen{via_clause}
coach.scheme.step.clear.nobody = zunächst müssten {targets} verschwinden; momentan kann keine eigene Figur sie angreifen
coach.scheme.step.maneuver = anschließend den {piece} auf {to} aufstellen ({route})
coach.scheme.step.maneuver.alt = alternativ {piece} von {agent} einsetzen ({route})
coach.scheme.step.exploit = danach {plan}
coach.maneuver.lead = Ein wichtiger Zug für {side}: {clause}.
coach.maneuver.opposition = den König nach {to} stellen und die Opposition übernehmen
coach.maneuver.generic = {piece} von {from} nach {to} führen
