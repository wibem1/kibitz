# plans.tmpl — plan sentences built from imbalance PlanHints.
# Slots: {side} ("White"/"Black", the side the imbalance favors), {plan}
# (a lowercase verb phrase from the plan.* keys, or the humanized hint
# token), {squares_clause} (empty, or " (key squares: ...)" from the hint).
# The `.more` variants are used for the second and later plans.

plan.lead.side = Ein guter Plan für {side}: {plan}{squares_clause}.
plan.lead.side.more = Ein weiterer Plan für {side}: {plan}{squares_clause}.
plan.lead.neutral = Ein möglicher Plan: {plan}{squares_clause}.
plan.lead.neutral.more = Eine weitere Möglichkeit: {plan}{squares_clause}.
clause.plan_squares = (Schlüsselfelder: {squares})

# Known plan-hint tokens; unknown tokens are humanized mechanically
# ("BlockadeThenPressure" -> "blockade then pressure").
plan.BlockadeThenPressure = den schwachen Bauern blockieren und anschließend angreifen
plan.OpenThePosition = nach Möglichkeiten suchen, die Stellung zu öffnen
plan.EscortThePasser = den Freibauern mit dem König unterstützen
plan.PushThePasser = den Freibauern vorziehen
plan.ManeuverKnight = den Springer auf ein günstigeres Feld manövrieren
plan.TradePieces = Figuren abtauschen, um die beengte Stellung zu entlasten
plan.PrepareBreak = einen befreienden Bauernhebel vorbereiten
plan.MinorityAttack = die Flügelbauern für einen Minoritätsangriff vorziehen
plan.PlayOnQueenside = am Damenflügel Druck aufbauen
plan.PlayOnKingside = am Königsflügel Druck aufbauen
plan.KeepPositionClosed = die Stellung geschlossen halten, damit die Springer ihre Stärke ausspielen
plan.OpenPositionForBishops = die Stellung öffnen, damit die Läufer wirksam werden
plan.AdvanceQueensideMajority = die Bauernmehrheit am Damenflügel vorziehen
plan.BlockadeWhitePasser = den weißen Freibauern blockieren
plan.BlockadeBlackPasser = den schwarzen Freibauern blockieren
plan.DoubleOnOpenFile = die Schwerfiguren auf der offenen Linie verdoppeln
plan.ManeuverKnightToOutpost = den Springer zu einem Vorposten führen
plan.ManeuverBishopToSupportPoint = den Läufer zum geeigneten Stützpunkt manövrieren
plan.ManeuverRookToOpenFile = einen Turm auf die offene Linie bringen
plan.UseSpaceAvoidExchanges = den Raumvorteil nutzen und Figurenabtausch vermeiden
plan.OpenPositionBeforeOpponentCompletes = die Stellung öffnen, bevor der Gegner seine Entwicklung abschließt
plan.WingPawnStormClosedCenter = die Flügelbauern vorziehen, während das geschlossene Zentrum Gegenangriffe erschwert
plan.RookToSeventh = einen Turm auf die siebte Reihe bringen
plan.RookBehindPasser = den Turm hinter den Freibauern stellen
plan.PressureBackwardPawn = den rückständigen Bauern auf der halboffenen Linie unter Druck setzen
plan.PressureDoubledPawn = den vorderen Doppelbauern angreifen
plan.TradeOrActivateBadBishop = den schlechten Läufer abtauschen oder außerhalb der Bauernkette aktivieren
plan.ActivateKingInEndgame = den König im Endspiel ins Zentrum führen
plan.RestrictKnight = dem gegnerischen Springer sichere Stützpunkte verwehren
plan.ActivateEntombedPiece = die eingeschlossene Figur befreien oder abtauschen
plan.KeepPieceEntombed = die gegnerische Figur eingeschlossen halten
plan.UprootBlockader = die Blockadefigur angreifen, abtauschen oder vertreiben
plan.ChooseBlockader = den Springer als geeignete Blockadefigur einsetzen
plan.AlternateTargets = abwechselnd beide Schwächen angreifen, um die Verteidigung zu überlasten
plan.OutsidePasserDecoy = mit dem entfernten Freibauern den gegnerischen König ablenken
plan.AdvanceCentralMajority = die Bauernmehrheit im Zentrum vorziehen
plan.OpenLinesTowardWeakKing = Linien gegen den gefährdeten König öffnen
plan.UndermineDefender = den Bauern angreifen, der das gewünschte Feld deckt
plan.CreatePassedPawn = die Bauernmehrheit vorziehen und einen Freibauern bilden
plan.HuntBishopPair = einen gegnerischen Läufer gegen einen Springer tauschen
plan.TradeSquareDefender = die Figur abtauschen, die das Schlüsselfeld deckt
plan.TargetWeakPawn = den dauerhaft schwachen Bauern mehrfach angreifen
plan.AttackWhereYouAreStronger = auf dem Flügel mit der eigenen Figurenüberlegenheit angreifen
plan.KeepBestPiece = die stärkste eigene Figur behalten und das Spiel um sie aufbauen
plan.TradeOffAttacker = die gefährlichste Angriffsfigur gegen den König abtauschen
plan.OverprotectStrongPoint = den eigenen Stützpunkt mehrfach decken

# Development prior (run 11): the classical principles as plans.
plan.CompleteDevelopment = die Entwicklung abschließen und die übrigen Leichtfiguren aktivieren
plan.CastleIntoSafety = rochieren und den König in Sicherheit bringen
plan.ClaimTheCenter = mit einem Zentrumsbauern Raum im Zentrum gewinnen
plan.QueenAheadOfHerArmy = die Dame rechtzeitig zurückführen, bevor der Gegner sie mit Tempo angreift
plan.SamePieceWandering = nicht dieselbe Figur wiederholt ziehen, sondern eine unentwickelte Figur aktivieren

# Composite plans (schema v2): several imbalances converging on one point.
plan.composite.lead = Mehrere Faktoren sprechen für {target}: {clauses}.
plan.composite.runner_up = Ein weiterer Ansatz für {side} betrifft {target}.
plan.composite.clause.ManeuverKnightToOutpost = den Springer dorthin manövrieren
plan.composite.clause.UndermineDefender = den deckenden Bauern beseitigen
plan.composite.clause.CreatePassedPawn = einen Freibauern bilden
plan.composite.clause.HuntBishopPair = einen Läufer gegen einen Springer tauschen
plan.composite.clause.TradeSquareDefender = die deckende Figur abtauschen
plan.composite.clause.TargetWeakPawn = den schwachen Bauern angreifen
plan.composite.clause.AttackWhereYouAreStronger = dort mit Kräfteüberlegenheit angreifen
plan.composite.clause.KeepBestPiece = die stärkste Figur behalten
plan.composite.clause.TradeOffAttacker = die gefährlichste Angriffsfigur abtauschen
plan.composite.clause.OverprotectStrongPoint = den Stützpunkt zusätzlich decken
plan.composite.clause.ManeuverBishopToSupportPoint = den Läufer auf dieses Feld führen
plan.composite.clause.ManeuverRookToOpenFile = einen Turm auf diese Linie bringen
plan.composite.clause.PressureBackwardPawn = den rückständigen Bauern davor angreifen
plan.composite.clause.BlockadeWhitePasser = den Freibauern dort blockieren
plan.composite.clause.BlockadeBlackPasser = den Freibauern dort blockieren
plan.composite.clause.DoubleOnOpenFile = die Schwerfiguren auf der Linie verdoppeln
plan.composite.clause.AdvanceQueensideMajority = die Bauernmehrheit dorthin vorziehen
plan.composite.clause.KeepPositionClosed = die Stellung dort geschlossen halten
plan.composite.clause.UseSpaceAvoidExchanges = den Raumvorteil für Druck nutzen
plan.composite.clause.OpenPositionForBishops = Linien für die Läufer in diese Richtung öffnen
plan.composite.clause.OpenPositionBeforeOpponentCompletes = dort vor Abschluss der gegnerischen Entwicklung angreifen
plan.composite.clause.WingPawnStormClosedCenter = diesen Flügel mit Bauern angreifen
plan.composite.clause.RookToSeventh = einen Turm auf dieses Feld führen
plan.composite.clause.RookBehindPasser = den Turm hinter dem Freibauern platzieren
plan.composite.clause.PressureDoubledPawn = den Doppelbauern dort angreifen
plan.composite.clause.TradeOrActivateBadBishop = den schlechten Läufer dort aktivieren oder abtauschen
plan.composite.clause.ActivateKingInEndgame = den König dorthin führen
plan.composite.clause.RestrictKnight = dem gegnerischen Springer dieses Feld verwehren
plan.composite.clause.ActivateEntombedPiece = die eingeschlossene Figur dort befreien
plan.composite.clause.KeepPieceEntombed = die gegnerische Figur dort eingeschlossen halten
plan.composite.clause.UprootBlockader = die Blockadefigur dort vertreiben
plan.composite.clause.ChooseBlockader = den Springer für die Blockade einsetzen
plan.composite.clause.AlternateTargets = abwechselnd beide Schwächen angreifen
plan.composite.clause.OutsidePasserDecoy = den entfernten Freibauern als Ablenkung nutzen
plan.composite.clause.AdvanceCentralMajority = die zentrale Bauernmehrheit vorziehen
plan.composite.clause.OpenLinesTowardWeakKing = Linien gegen den König öffnen
plan.composite.clause.MinorityAttack = mit der Bauernminderheit angreifen
plan.composite.clause.CompleteDevelopment = zuerst die Entwicklung abschließen
plan.composite.clause.CastleIntoSafety = vorher rochieren
plan.composite.clause.ClaimTheCenter = das Zentrum dort besetzen
plan.composite.clause.QueenAheadOfHerArmy = die Dame zuerst zurückführen
plan.composite.clause.SamePieceWandering = nicht dieselbe Figur wiederholt ziehen

# Candidate-move closing (run 10): {first}/{second} are SAN moves, {n} a
# spelled-out count, {their_plan} a plan verb phrase (base plan.* keys).
suggest.close = Konkret: {first} unterstützt {n} Pläne gleichzeitig; {second} ist eine Alternative.
suggest.close.solo = Konkret: {first} unterstützt {n} Pläne gleichzeitig.
suggest.close.one = Konkret: {first} fördert den Hauptplan; {second} ist eine Alternative.
suggest.close.one.solo = Konkret: {first} fördert den Hauptplan.
suggest.prophylactic = Zuerst den gegnerischen Plan verhindern: Der Gegner will {their_plan}; {first} durchkreuzt diese Absicht.
suggest.count.two = zwei
suggest.count.three = drei
suggest.count.four = vier
suggest.count.many = mehrere
